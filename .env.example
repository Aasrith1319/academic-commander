# ═══════════════════════════════════════════════════════════════════════════════
# ⚡ Academic Commander — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control!
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Google Cloud / Gemini ───────────────────────────────────────────────────
# Your Google Cloud project ID (required for Agent Builder & Gemini API)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Google Gemini API key (get from https://aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key

# Gemini model to use (default: gemini-3-flash)
GEMINI_MODEL=gemini-3-flash

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# MongoDB connection URI (Atlas or local)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MONGO_DB_NAME=academic_commander

# ─── Elasticsearch ───────────────────────────────────────────────────────────
# Elasticsearch host URL
ELASTICSEARCH_URL=http://localhost:9200

# Elasticsearch API key (if using Elastic Cloud)
ELASTICSEARCH_API_KEY=your-elasticsearch-api-key

# Elasticsearch index prefix
ELASTICSEARCH_INDEX_PREFIX=academic_commander

# ─── GitLab ──────────────────────────────────────────────────────────────────
# GitLab instance URL
GITLAB_URL=https://gitlab.com

# GitLab personal access token (needs api scope)
GITLAB_TOKEN=your-gitlab-personal-access-token

# GitLab project ID for the assignment repository
GITLAB_PROJECT_ID=12345678

# ─── Arize AI (Observability & Tracing) ──────────────────────────────────────
# Arize API key for agent observability
ARIZE_API_KEY=your-arize-api-key

# Arize Space ID
ARIZE_SPACE_ID=your-arize-space-id

# Arize model ID for this project
ARIZE_MODEL_ID=academic-commander-agent

# ─── MCP Server Configuration ───────────────────────────────────────────────
# Ports for each MCP server (defaults shown)
MCP_INGESTION_PORT=5001
MCP_MONGODB_PORT=5002
MCP_ELASTICSEARCH_PORT=5003
MCP_GITLAB_PORT=5004
MCP_ARIZE_PORT=5005

# ─── Streamlit Dashboard ────────────────────────────────────────────────────
# Streamlit server port (default: 8501)
STREAMLIT_PORT=8501

# Enable demo/mock mode (true = no live DB required)
DEMO_MODE=false

# ─── Logging ─────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log output file path
LOG_FILE=logs/academic_commander.log
